# PostgreSQL connection string. Coolify can provision this as a managed
# resource — see the "Deploy" section in README.md.
DATABASE_URL="postgresql://user:password@host:5432/id_system_universe"

# Session signing/authentication secret. Generate with:
#   openssl rand -hex 32
AUTH_SECRET="replace-with-a-random-64-character-hex-string"

# Master key used to encrypt Coolify API tokens at rest (AES-256-GCM).
# Must be a base64-encoded 32-byte key. Generate with:
#   openssl rand -base64 32
# Losing this key makes every stored provider token permanently unreadable —
# back it up somewhere other than the database.
CREDENTIAL_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"

NODE_ENV="production"
