// ID System Universe — schema mínimo. O Coolify (e futuros providers) continuam
// sendo a fonte da verdade da infraestrutura; aqui só cacheamos o necessário
// para a UI e para auditoria.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  /// Acesso global total (inclui financeiro e integrações). ADMIN segue como antes.
  SUPERADMIN
  ADMIN
  OPERATOR
  VIEWER
}

enum ProviderType {
  COOLIFY
  DOCKER
  VERCEL
  RAILWAY
  RENDER
  KUBERNETES
}

enum ProviderHealth {
  ONLINE
  DEGRADED
  OFFLINE
  UNKNOWN
}

enum ApplicationStatus {
  RUNNING
  STOPPED
  DEPLOYING
  ERROR
  UNKNOWN
}

enum ViewMode {
  UNIVERSE
  LIST
}

/// What kind of thing a resource is. Only types we actually sync from a
/// provider today — expand this enum when a real integration for the next
/// type (Redis, worker, cron, storage, domain, repository...) exists, never
/// before.
enum ResourceType {
  APPLICATION
  SERVICE
  DATABASE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Permissões extras concedidas além do role (ex.: BILLING_VIEW, BILLING_MANAGE).
  extraPermissions String[] @default([])

  sessions               Session[]
  auditEvents            AuditEvent[]
  preference             UserPreference?
  projectAccess          ProjectAccess[]
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
}

/// Quais Projects um usuário OPERATOR/VIEWER enxerga. SUPERADMIN e ADMIN têm
/// acesso global e ignoram esta tabela.
model ProjectAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([projectId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reducedGraphics Boolean  @default(false)
  defaultView     ViewMode @default(UNIVERSE)
  updatedAt       DateTime @updatedAt
}

/// A product/SaaS in the ID System portfolio (Italoc, FinFlow, ...). A Universe
/// concept, not a Coolify one — a project's resources can span multiple
/// providers, and a provider hosts resources from multiple projects. Never
/// hardcoded: rows are created by an admin or by accepting an assignment
/// suggestion for unassigned resources.
model Project {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  accent      String    @default("#38bdf8")
  enabled     Boolean   @default(true)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  resources      Application[]
  auditEvents    AuditEvent[]
  universeEvents UniverseEvent[]
  access         ProjectAccess[]
  clientLinks    ClientProject[]
  charges        Charge[]
  recurrences    BillingRecurrence[]
  deploymentRuns DeploymentRun[]
}

/// Uma instância/conta administrada (Coolify hoje; outros providers futuramente).
model InfrastructureProvider {
  id                  String         @id @default(cuid())
  type                ProviderType   @default(COOLIFY)
  name                String
  baseUrl             String
  encryptedToken      String
  enabled             Boolean        @default(true)
  color               String         @default("#38bdf8")
  metadata            Json?
  health              ProviderHealth @default(UNKNOWN)
  latencyMs           Int?
  lastCheckAt         DateTime?
  lastSuccessAt       DateTime?
  lastError           String?
  consecutiveFailures Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  applications   Application[]
  auditEvents    AuditEvent[]
  universeEvents UniverseEvent[]
}

/// Cache normalizado de uma aplicação de um provider. O id interno (cuid) é
/// estável mesmo que a instância de origem mude; externalId é o UUID do
/// Coolify e só é único dentro do provider, nunca globalmente.
model Application {
  id                          String                 @id @default(cuid())
  externalId                  String
  providerId                  String
  provider                    InfrastructureProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  /// Nullable on purpose — a freshly synced resource starts unassigned until
  /// an admin assigns it to a Project (see "Unassigned Resources").
  projectId                   String?
  project                     Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  resourceType                ResourceType           @default(APPLICATION)
  /// The provider's own grouping key for this resource (Coolify: the
  /// Environment UUID it lives in) — null for a provider without this
  /// concept. Used only to auto-link a freshly-synced resource to the
  /// Project matching its provider-side grouping; never shown in the UI.
  groupExternalId             String?
  name                        String
  description                 String?
  status                      ApplicationStatus      @default(UNKNOWN)
  fqdn                        String?
  repository                  String?
  branch                      String?
  lastDeployedAt              DateTime?
  lastSyncedAt                DateTime               @default(now())
  pendingOperation            String?
  pendingSince                DateTime?
  pendingDeploymentExternalId String?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  deployments     DeploymentCache[]
  auditEvents     AuditEvent[]
  universeEvents  UniverseEvent[]
  repositoryLink  ResourceRepository?
  deploymentRuns  DeploymentRun[]
  errorGroups     ErrorGroup[]
  errorScan       ErrorScanState?
  errorDaily      ErrorDaily[]
  deployIncidents DeployIncident[]

  @@unique([providerId, externalId])
  @@index([providerId])
  @@index([projectId])
  @@index([providerId, groupExternalId])
}

model DeploymentCache {
  id            String      @id @default(cuid())
  externalId    String
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        String
  commit        String?
  commitMessage String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime    @default(now())
  /// Histórico: log do deploy guardado quando ele termina (o Coolify apaga deploys antigos). Segredos já mascarados.
  logs          String?
  logsSavedAt   DateTime?

  @@unique([applicationId, externalId])
  @@index([applicationId])
}

/// Erros vistos nos logs de runtime dos sistemas, agrupados por "impressão digital" (o mesmo erro com horas e números
/// diferentes é um item só). Alimentado pelo coletor do servidor; lido pelos agentes CLT e pelo painel. Guardado por 30 dias.
model ErrorGroup {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fingerprint   String
  /// Última ocorrência (linha + stack trace), com segredos mascarados.
  sample        String
  count         Int         @default(1)
  firstSeenAt   DateTime
  lastSeenAt    DateTime
  /// Fila de correção do ID Manager: tarefa enviada, quando, e se o humano descartou o item. Voltar a aparecer erro depois disso reabre o item.
  fixTaskId     String?
  fixSentAt     DateTime?
  dismissedAt   DateTime?

  @@unique([applicationId, fingerprint])
  @@index([lastSeenAt])
}

/// Erros por dia e por sistema (dia no fuso de São Paulo, "AAAA-MM-DD"): alimenta os gráficos do painel da equipe.
model ErrorDaily {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  day           String
  count         Int         @default(0)

  @@unique([applicationId, day])
  @@index([day])
}

/// Incidente aberto quando um deploy falha: a equipe CLT acha a causa e corrige. O agente que fez o PR do commit quebrado fica
/// bloqueado (AgentProfile.lockedByIncidentId) até o incidente fechar. Um incidente por (sistema, deploy).
model DeployIncident {
  id                   String      @id @default(cuid())
  applicationId        String
  application          Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  deploymentExternalId String
  commitSha            String?
  commitMessage        String?
  repository           String?
  /// OPEN (em conserto) | RESOLVED (um deploy seguinte teve sucesso) | ESCALATED (3 tentativas ou 6 h sem resolver: precisa de humano)
  status               String      @default("OPEN")
  /// Quantos deploys falharam dentro deste incidente (1 = o original; cada correção que também falha soma 1).
  attempts             Int         @default(1)
  /// Tarefa do ID Manager que coordena o conserto: as tarefas delegadas por ela (parentTaskId) são quem pode mergear a correção.
  managerTaskId        String?
  /// Agente (de projeto) cujo PR gerou o commit quebrado; ficou bloqueado enquanto o incidente estava aberto.
  culpritAgentId       String?
  /// O culpado já estava pausado (por um humano) antes do bloqueio: ao fechar o incidente ele continua pausado.
  culpritWasPaused     Boolean     @default(false)
  summary              String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  resolvedAt           DateTime?

  @@unique([applicationId, deploymentExternalId])
  @@index([applicationId, status])
  @@index([status, createdAt])
}

/// Última leitura de logs de um sistema: as linhas de erro já contadas, para não contá-las de novo na leitura seguinte.
model ErrorScanState {
  applicationId String      @id
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  seen          String[]
  scannedAt     DateTime
}

/// Trilha de auditoria administrativa. Nunca guarda segredos.
model AuditEvent {
  id            String                  @id @default(cuid())
  userId        String?
  user          User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  providerId    String?
  provider      InfrastructureProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  applicationId String?
  application   Application?            @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  action        String
  status        String
  metadata      Json?
  /// Entidade não-infra afetada (ex.: "Charge", "Client", "GitHubInstallation").
  entityType    String?
  entityId      String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime                @default(now())

  @@index([createdAt])
  @@index([applicationId])
  @@index([projectId])
  @@index([entityType, entityId])
}

/// Feed de eventos do Universe (barra inferior + Activity Center).
model UniverseEvent {
  id              String                  @id @default(cuid())
  applicationId   String?
  application     Application?            @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  applicationName String?
  providerId      String?
  provider        InfrastructureProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectName     String?
  type            String
  message         String
  /// Quando preenchido, só quem possui esta permissão vê o evento (ex.: "billing:view").
  permission      String?
  createdAt       DateTime                @default(now())

  @@index([createdAt])
}

/// Flags simples de sistema (ex.: bootstrap do primeiro admin já usado).
model SystemSetting {
  key   String @id
  value String
}

// ---------------------------------------------------------------------------
// Integrações (GitHub App, WhatsApp). Segredos SEMPRE criptografados e só no
// backend — nunca retornados ao navegador.
// ---------------------------------------------------------------------------

model IntegrationConfig {
  key       String   @id
  value     String
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

enum GitHubInstallationStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model GitHubInstallation {
  id                  String                   @id @default(cuid())
  installationId      String                   @unique
  accountLogin        String
  accountType         String
  accountId           String?
  repositorySelection String?
  status              GitHubInstallationStatus @default(ACTIVE)
  lastSyncedAt        DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  repositories GitHubRepository[]
}

model GitHubRepository {
  id             String             @id @default(cuid())
  installationId String
  installation   GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  externalId     String
  fullName       String
  ownerLogin     String
  name           String
  defaultBranch  String?
  isPrivate      Boolean            @default(false)
  archived       Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  resourceLinks ResourceRepository[]
  agentLinks    AgentProfile[]
  agentExtras   AgentRepository[]

  @@unique([installationId, externalId])
  @@index([fullName])
}

/// Vínculo Resource ↔ repositório GitHub + configuração de Auto Deploy.
model ResourceRepository {
  id                 String            @id @default(cuid())
  applicationId      String            @unique
  application        Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  githubRepositoryId String?
  githubRepository   GitHubRepository? @relation(fields: [githubRepositoryId], references: [id], onDelete: SetNull)
  repositoryFullName String
  branch             String
  autoDeploy         Boolean           @default(false)
  onPush             Boolean           @default(true)
  onMerge            Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([repositoryFullName, branch])
}

/// Deduplicação por X-GitHub-Delivery.
model GitHubWebhookDelivery {
  deliveryId  String    @id
  event       String
  action      String?
  status      String    @default("RECEIVED")
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

enum DeploymentRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  SUPERSEDED
}

enum DeploymentTrigger {
  MANUAL
  GITHUB_PUSH
  GITHUB_MERGE
}

/// Uma tentativa de deploy de um Resource: de onde veio, qual commit, e como terminou.
model DeploymentRun {
  id                  String              @id @default(cuid())
  applicationId       String
  application         Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  projectId           String?
  project             Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  repository          String?
  branch              String?
  commitSha           String?
  commitMessage       String?
  commitAuthor        String?
  commitUrl           String?
  triggerSource       DeploymentTrigger
  status              DeploymentRunStatus @default(QUEUED)
  deliveryId          String?
  coolifyDeploymentId String?
  /// Commit que o provider (Coolify) reporta ter implantado de fato.
  deployedCommitSha   String?
  userId              String?
  error               String?
  receivedAt          DateTime            @default(now())
  startedAt           DateTime?
  finishedAt          DateTime?
  createdAt           DateTime            @default(now())

  /// Mesmo repo + branch + commit nunca vira dois deploys do mesmo Resource.
  @@unique([applicationId, repository, branch, commitSha])
  @@index([applicationId, status])
  @@index([coolifyDeploymentId])
  @@index([applicationId, finishedAt])
}

// ---------------------------------------------------------------------------
// Clientes e Central de Cobranças
// ---------------------------------------------------------------------------

model Client {
  id        String   @id @default(cuid())
  name      String
  tradeName String?
  document  String?
  phone     String?
  /// Sempre normalizado (somente dígitos, formato internacional, ex.: 5511999998888).
  whatsapp  String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects    ClientProject[]
  charges     Charge[]
  recurrences BillingRecurrence[]
  messages    WhatsAppMessage[]

  @@index([name])
}

model ClientProject {
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([clientId, projectId])
  @@index([projectId])
}

model BillingReason {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  charges     Charge[]
  recurrences BillingRecurrence[]
}

enum RecurrencePeriod {
  WEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}

enum RecurrenceStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum ChargeStatus {
  PENDING
  PAID
  CANCELLED
}

model BillingRecurrence {
  id              String           @id @default(cuid())
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId       String?
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reasonId        String?
  reason          BillingReason?   @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  description     String
  amountCents     Int
  period          RecurrencePeriod @default(MONTHLY)
  /// Só para CUSTOM: intervalo em dias.
  intervalDays    Int?
  /// Dia do mês do vencimento (1-31, ajustado ao último dia quando o mês é menor).
  dueDay          Int?
  startDate       DateTime         @db.Date
  endDate         DateTime?        @db.Date
  status          RecurrenceStatus @default(ACTIVE)
  whatsappEnabled Boolean          @default(true)
  notes           String?
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  charges       Charge[]
  reminderRules ChargeReminderRule[]

  @@index([status])
  @@index([clientId])
}

model Charge {
  id              String             @id @default(cuid())
  clientId        String
  client          Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId       String?
  project         Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  recurrenceId    String?
  recurrence      BillingRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  reasonId        String?
  reason          BillingReason?     @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  description     String
  /// Valores sempre em centavos (inteiro) — nunca float.
  amountCents     Int
  /// Data civil (sem fuso): o dia 10 nunca vira dia 9.
  dueDate         DateTime           @db.Date
  /// Período cobrado (ex.: 2026-11). Chave de idempotência da recorrência.
  competence      String?
  status          ChargeStatus       @default(PENDING)
  notes           String?
  whatsappEnabled Boolean            @default(true)
  paidAt          DateTime?
  cancelledAt     DateTime?
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  payments      ChargePayment[]
  reminderRules ChargeReminderRule[]
  reminders     ChargeReminder[]
  messages      WhatsAppMessage[]

  /// Uma recorrência nunca gera duas cobranças para a mesma competência.
  @@unique([recurrenceId, competence])
  @@index([dueDate, status])
  @@index([clientId])
  @@index([projectId])
}

model ChargePayment {
  id               String    @id @default(cuid())
  chargeId         String
  charge           Charge    @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  amountCents      Int
  paidAt           DateTime
  method           String?
  notes            String?
  reversedAt       DateTime?
  reversedByUserId String?
  createdByUserId  String?
  createdAt        DateTime  @default(now())

  @@index([chargeId])
}

enum ReminderDirection {
  BEFORE
  ON
  AFTER
}

/// Régua de cobrança. Pertence a uma Charge ou é o modelo de uma Recorrência
/// (copiado para cada cobrança gerada).
model ChargeReminderRule {
  id           String             @id @default(cuid())
  chargeId     String?
  charge       Charge?            @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  recurrenceId String?
  recurrence   BillingRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  direction    ReminderDirection
  offsetDays   Int                @default(0)
  /// HH:mm no fuso configurado.
  sendTime     String             @default("09:00")
  template     String?
  enabled      Boolean            @default(true)
  createdAt    DateTime           @default(now())

  reminders ChargeReminder[]

  @@index([chargeId])
  @@index([recurrenceId])
}

enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

/// Um aviso agendado. A unique (cobrança, regra, horário) é a chave de idempotência.
model ChargeReminder {
  id            String             @id @default(cuid())
  chargeId      String
  charge        Charge             @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  ruleId        String
  rule          ChargeReminderRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  status        ReminderStatus     @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime?
  lockedAt      DateTime?
  lastError     String?
  skippedReason String?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([chargeId, ruleId, scheduledAt])
  @@index([status, scheduledAt])
}

/// Template editável por tipo de aviso (BEFORE/ON/AFTER).
model BillingTemplate {
  kind      ReminderDirection @id
  body      String
  updatedAt DateTime          @updatedAt
}

enum WhatsAppMessageStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum WhatsAppMessageKind {
  AUTOMATIC
  MANUAL
}

/// Log de cada tentativa de envio pelo canal WhatsApp.
model WhatsAppMessage {
  id                String                @id @default(cuid())
  clientId          String?
  client            Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  chargeId          String?
  charge            Charge?               @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  reminderId        String?
  kind              WhatsAppMessageKind
  toPhone           String
  body              String
  status            WhatsAppMessageStatus @default(PENDING)
  providerMessageId String?
  error             String?
  createdByUserId   String?
  sentAt            DateTime?
  createdAt         DateTime              @default(now())

  @@index([chargeId])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Monitoramento de VPS: um agente leve no servidor ENVIA métricas (push) com um
// token por servidor. Só o hash do token fica guardado.
// ---------------------------------------------------------------------------

model MonitoredServer {
  id               String    @id @default(cuid())
  name             String
  tokenHash        String    @unique
  hostname         String?
  os               String?
  kernel           String?
  cpuModel         String?
  cpuCores         Int?
  agentVersion     String?
  ipAddress        String?
  lastSeenAt       DateTime?
  /// Snapshot dos containers do último envio (nome, cpu, memória, status).
  latestContainers Json?
  /// Estado dos alertas já emitidos — só notifica na transição (ok → alerta → ok).
  alertState       Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  metrics ServerMetric[]
}

model ServerMetric {
  id                String          @id @default(cuid())
  serverId          String
  server            MonitoredServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  ts                DateTime        @default(now())
  cpuPercent        Float
  load1             Float
  load5             Float
  load15            Float
  memUsedMb         Int
  memTotalMb        Int
  swapUsedMb        Int             @default(0)
  swapTotalMb       Int             @default(0)
  diskUsedMb        Int
  diskTotalMb       Int
  netRxBps          Float           @default(0)
  netTxBps          Float           @default(0)
  diskReadBps       Float           @default(0)
  diskWriteBps      Float           @default(0)
  procs             Int             @default(0)
  containersRunning Int             @default(0)
  containersTotal   Int             @default(0)
  uptimeSec         Int             @default(0)

  @@index([serverId, ts])
}

/// Uma "fonte" de eventos de agentes Claude (ex.: um ambiente de nuvem). O token só existe em hash.
model AgentFeed {
  id        String         @id @default(cuid())
  name      String
  tokenHash String         @unique
  createdAt DateTime       @default(now())
  sessions  AgentSession[]
}

model AgentSession {
  id             String          @id @default(cuid())
  feedId         String
  feed           AgentFeed       @relation(fields: [feedId], references: [id], onDelete: Cascade)
  /// session_id enviado pelo hook do Claude Code.
  externalId     String
  repo           String?
  branch         String?
  model          String?
  /// Último estado reportado: WORKING | WAITING | ENDED. ERROR e "ocioso" são derivados na leitura.
  phase          String          @default("WORKING")
  lastTool       String?
  lastTarget     String?
  lastToolFailed Boolean         @default(false)
  toolCount      Int             @default(0)
  failedCount    Int             @default(0)
  startedAt      DateTime        @default(now())
  lastEventAt    DateTime        @default(now())
  endedAt        DateTime?
  events         AgentEvent[]
  commands       AgentCommand[]
  approvals      AgentApproval[]

  @@unique([feedId, externalId])
  @@index([lastEventAt])
}

model AgentEvent {
  id        String       @id @default(cuid())
  sessionId String
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ts        DateTime     @default(now())
  kind      String
  tool      String?
  target    String?
  ok        Boolean      @default(true)

  @@index([sessionId, ts])
  @@index([ts])
}

/// Pedido enviado pelo painel a uma sessão ativa. Entregue pelo hook (Stop/PostToolUse/UserPromptSubmit).
model AgentCommand {
  id          String       @id @default(cuid())
  sessionId   String
  session     AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  text        String
  /// PENDING | DELIVERED | CANCELLED
  status      String       @default("PENDING")
  createdById String?
  createdAt   DateTime     @default(now())
  deliveredAt DateTime?

  @@index([sessionId, status, createdAt])
}

/// Pedido de permissão do Claude (diálogo "posso executar isto?") respondido pelo painel via hook PermissionRequest.
model AgentApproval {
  id          String       @id @default(cuid())
  sessionId   String
  session     AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tool        String
  /// Resumo do que será executado (já sem segredos), até 500 caracteres.
  detail      String
  /// PENDING | APPROVED | DENIED | EXPIRED
  status      String       @default("PENDING")
  decidedById String?
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?

  @@index([sessionId, status, createdAt])
}

// ---------------------------------------------------------------------------
// Orquestrador de agentes Claude: o Universe é quem manda; a execução é real (Claude Agent SDK).
// ---------------------------------------------------------------------------

/// Funcionário permanente da Sala dos Agentes. Existe independentemente de ter tarefa.
model AgentProfile {
  id                 String             @id @default(cuid())
  name               String
  specialty          String?
  /// Diretório de trabalho NO SERVIDOR do Universe (onde o Claude roda).
  cwd                String
  projectId          String?
  /// Repositório GitHub ligado DIRETO ao agente (tem prioridade sobre o repositório do recurso do projeto).
  githubRepositoryId String?
  githubRepository   GitHubRepository?  @relation(fields: [githubRepositoryId], references: [id], onDelete: SetNull)
  /// Branch base do PR (vazio = a padrão do repositório).
  githubBranch       String?
  model              String?
  /// default | acceptEdits | plan — "bypassPermissions" nunca é oferecido.
  permissionMode     String             @default("default")
  /// low | medium | high | xhigh | max (vazio = padrão do Claude).
  effort             String?
  /// Ferramentas liberadas sem pedir aprovação (ex.: "Read", "Bash(git status:*)").
  allowedTools       String[]           @default([])
  /// Ferramentas bloqueadas para este agente.
  disallowedTools    String[]           @default([])
  /// Pausado: continua na sala, mas não recebe execuções (tarefas ficam na fila).
  paused             Boolean            @default(false)
  /// Equipe a que o agente pertence ("CLT" = AGENTES CLT). Nulo = agente avulso da Ala Operacional.
  team               String?
  /// Identificador estável do cargo dentro da equipe (ex.: "id-guardian"). Único.
  slug               String?            @unique
  roleTitle          String?
  description        String?
  /// Limites de tokens (entrada + saída + cache). Nulo = sem limite. O worker recusa novas execuções ao estourar.
  dailyTokenLimit    Int?
  monthlyTokenLimit  Int?
  /// Sessão Claude persistente (resume) — o contexto continua entre tarefas.
  claudeSessionId    String?
  lastError          String?
  lastActiveAt       DateTime?
  /// Ordem estável das mesas.
  position           Int                @default(0)
  archivedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tasks              AgentTask[]
  pullRequests       AgentPullRequest[]
  agentRepositories  AgentRepository[]
  routines           AgentRoutine[]
  /// Incidente de deploy que bloqueou este agente (ele causou o deploy que falhou). Nulo = livre. Só o incidente que bloqueou desbloqueia.
  lockedByIncidentId String?

  @@index([archivedAt, position])
}

model AgentTask {
  id              String              @id @default(cuid())
  agentId         String
  agent           AgentProfile        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Um clique em ENVIAR = uma chave. Reenvio com a mesma chave devolve a mesma tarefa.
  idempotencyKey  String              @unique
  prompt          String
  /// QUEUED | STARTING | RUNNING | WAITING_APPROVAL | COMPLETED | FAILED | CANCELLED | INTERRUPTED
  status          String              @default("QUEUED")
  createdById     String?
  createdAt       DateTime            @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  /// Última batida do executor: quem para de bater por 45 s foi interrompido (worker caiu).
  heartbeatAt     DateTime?
  result          String?
  error           String?
  claudeSessionId String?
  costUsd         Float?
  turns           Int?
  /// Tokens da execução (resultado do Claude): entrada, saída e cache (leitura + criação). Nulos em tarefas antigas.
  inputTokens     Int?
  outputTokens    Int?
  cacheTokens     Int?
  cancelRequested Boolean             @default(false)
  /// Ordem na fila quando vários agentes esperam: 1 alta · 0 normal · -1 baixa.
  priority        Int                 @default(0)
  /// Rotina agendada que criou a tarefa (nulo = pedido manual).
  routineId       String?
  /// Tarefa do ID Manager que delegou esta (nulo = não foi delegada).
  parentTaskId    String?
  nextSeq         Int                 @default(1)
  events          AgentTaskEvent[]
  attachments     AgentAttachment[]
  approvals       AgentTaskApproval[]

  @@index([agentId, status])
  @@index([status, createdAt])
  @@index([routineId])
  @@index([parentTaskId])
}

/// Rotina agendada de um agente (ex.: auditoria de segurança às 03:00). O servidor dispara sozinho, sem navegador aberto.
model AgentRoutine {
  id          String       @id @default(cuid())
  agentId     String
  agent       AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name        String
  prompt      String
  enabled     Boolean      @default(true)
  /// Dias da semana (0 = domingo … 6 = sábado).
  days        Int[]
  /// Horário local (America/Sao_Paulo) "HH:MM".
  time        String
  /// 1 alta · 0 normal · -1 baixa (ordem na fila).
  priority    Int          @default(0)
  /// always | changed | alert | activity — gatilho determinístico: sem ele o Claude nem é chamado.
  gate        String       @default("always")
  /// Último horário tratado ("AAAA-MM-DD HH:MM"): impede disparar duas vezes o mesmo horário.
  lastSlot    String?
  lastRunAt   DateTime?
  lastTaskId  String?
  /// "iniciada" ou "pulada: motivo".
  lastOutcome String?
  /// Marca do gatilho "changed" na última execução (último deploy com sucesso visto).
  lastGateKey String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([agentId])
}

model AgentTaskEvent {
  id     String    @id @default(cuid())
  taskId String
  task   AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  seq    Int
  ts     DateTime  @default(now())
  /// message_sent | started | assistant_text | tool_use | tool_result | approval_requested | approval_decided | completed | failed | cancelled | interrupted | info
  kind   String
  tool   String?
  text   String?

  @@unique([taskId, seq])
}

model AgentTaskApproval {
  id          String    @id @default(cuid())
  taskId      String
  task        AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tool        String
  detail      String
  /// PENDING | APPROVED | DENIED | EXPIRED
  status      String    @default("PENDING")
  decidedById String?
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  @@index([taskId, status])
}

/// Linha única ("default"): limites do orquestrador.
model OrchestratorSetting {
  id            String   @id @default("default")
  maxConcurrent Int      @default(2)
  /// Agentes executam comandos/edições (e o merge, com CI verde) sem pedir aprovação a cada passo.
  autoApprove   Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

/// Servidor MCP disponível para os agentes do Universe (segredos cifrados).
model AgentMcpServer {
  id         String   @id @default(cuid())
  name       String   @unique
  /// stdio | http | sse
  type       String
  command    String?
  args       String[] @default([])
  url        String?
  /// JSON cifrado: env (stdio) ou headers (http/sse). Nunca volta pela API, só as chaves.
  secretsEnc String?
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Aparelho/navegador que aceitou receber notificações push (Web Push, VAPID). Um usuário pode ter vários (celular, computador).
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  failures      Int       @default(0)
  lastSuccessAt DateTime?
  /// Último erro de entrega (ex.: "HTTP 403") — aparece no painel para diagnosticar "não chegou".
  lastError     String?
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

/// Quais tipos de aviso o usuário quer receber (pop-up e push).
model NotificationPreference {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deploys         Boolean  @default(true)
  agents          Boolean  @default(true)
  approvals       Boolean  @default(true)
  servers         Boolean  @default(true)
  billing         Boolean  @default(true)
  /// Canal extra: o mesmo aviso por WhatsApp (chega com o app fechado, em qualquer celular). Número só com dígitos, formato internacional.
  whatsappEnabled Boolean  @default(false)
  whatsappNumber  String?
  updatedAt       DateTime @updatedAt
}

/// PR aberto por um agente (ou pelo botão do painel): o Universe lembra dele para mergear e limpar a cópia depois.
model AgentPullRequest {
  id         String       @id @default(cuid())
  agentId    String
  agent      AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  taskId     String?
  repo       String
  number     Int
  url        String
  branch     String
  baseBranch String
  title      String
  /// OPEN | MERGED | CLOSED
  status     String       @default("OPEN")
  mergedAt   DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([repo, number])
  @@index([agentId, status])
}

/// Arquivo/imagem anexado a um comando para o agente. O conteúdo fica em disco (AGENT_ATTACHMENTS_DIR), nunca no banco.
model AgentAttachment {
  id         String     @id @default(cuid())
  userId     String?
  taskId     String?
  task       AgentTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name       String
  mime       String
  size       Int
  /// image (vai como imagem para o Claude) | file (o agente lê pelo caminho)
  kind       String
  storedPath String
  createdAt  DateTime   @default(now())

  @@index([taskId])
  @@index([createdAt])
}

/// Repositórios EXTRAS de um agente (além do principal em AgentProfile.githubRepositoryId): cada um é clonado em <cwd>.extras/<dir>.
model AgentRepository {
  id                 String           @id @default(cuid())
  agentId            String
  agent              AgentProfile     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  githubRepositoryId String
  githubRepository   GitHubRepository @relation(fields: [githubRepositoryId], references: [id], onDelete: Cascade)
  /// Branch base do PR (vazio = a padrão do repositório).
  branch             String?
  /// Nome da subpasta (único por agente).
  dir                String
  createdAt          DateTime         @default(now())

  @@unique([agentId, githubRepositoryId])
  @@unique([agentId, dir])
}

/// Achado registrado por um agente da equipe CLT (segurança, desempenho, qualidade, dívida técnica, documentação, infra...): vira item da fila de
/// correção do ID Manager ao lado dos erros dos logs. Mesmo achado repetido atualiza o existente (fingerprint) e, se já tinha sido tratado, reabre.
model AgentFinding {
  id              String    @id @default(cuid())
  fingerprint     String    @unique
  agentName       String
  applicationName String?
  title           String
  detail          String
  severity        String    @default("MEDIUM")
  category        String    @default("outro")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())
  fixTaskId       String?
  fixSentAt       DateTime?
  dismissedAt     DateTime?

  @@index([updatedAt])
}

/// Funil da equipe COMERCIAL & MARKETING: uma empresa prospectada (dados da EMPRESA, nunca de pessoa física). É o CRM do Universe — não há outro.
/// A impressão digital (site > telefone > nome+cidade) impede cadastro duplicado.
model Lead {
  id             String            @id @default(cuid())
  fingerprint    String            @unique
  /// Todas as chaves de identidade (site, telefone, nome+cidade): a empresa é a mesma se qualquer uma coincidir.
  keys           String[]
  name           String
  segment        String            @default("outro")
  city           String?
  address        String?
  phone          String?
  website        String?
  distanceKm     Float?
  /// Onde a empresa foi encontrada (URL ou nome da fonte) e quando.
  source         String
  foundAt        DateTime          @default(now())
  foundBy        String
  /// NOVO | EM_ANALISE | QUALIFICADO | AGUARDANDO_ABORDAGEM | PRIMEIRO_CONTATO | EM_NEGOCIACAO | CONVERTIDO | PERDIDO
  stage          String            @default("NOVO")
  /// ALTA | MEDIA | BAIXA (null = ainda não analisado)
  priority       String?
  priorityReason String?
  productFit     String?
  painPoints     String?
  missingInfo    String?
  /// Opinião do analista sobre a chance de conversão — nunca apresentada como fato.
  conversionNote String?
  techNeed       String?
  discarded      Boolean           @default(false)
  discardReason  String?
  lastContactAt  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  interactions   LeadInteraction[]

  @@index([stage, discarded])
  @@index([priority])
  @@index([updatedAt])
}

/// Histórico do lead: notas, mudanças de etapa, contatos e RASCUNHOS de abordagem. O Universe não envia nada: rascunho fica PENDENTE_APROVACAO até o humano decidir.
model LeadInteraction {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// NOTA | RASCUNHO | CONTATO | PROPOSTA | ETAPA
  kind        String
  /// WHATSAPP | EMAIL | TELEFONE | PRESENCIAL | OUTRO
  channel     String?
  content     String
  /// REGISTRADO | PENDENTE_APROVACAO | APROVADO | REJEITADO | ENVIADO
  status      String    @default("REGISTRADO")
  agentName   String
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
  decidedById String?

  @@index([leadId, createdAt])
  @@index([status, kind])
}

/// Descrição comercial de cada produto (SaaS), mantida pelos agentes CLT/humano e LIDA pela equipe comercial: ninguém promete o que não existe.
model ProductProfile {
  id             String   @id @default(cuid())
  name           String   @unique
  summary        String
  features       String
  idealSegments  String?
  commercialNote String?
  updatedBy      String
  updatedAt      DateTime @updatedAt
}

/// Configuração única (id = "default") da prospecção e do custo.
model CommercialSettings {
  id                   String   @id @default("default")
  baseCity             String   @default("Itatiaiuçu/MG")
  radiusKm             Int      @default(50)
  segments             String[]
  maxNewLeadsPerRun    Int      @default(10)
  /// Preço por milhão de tokens para estimar custo em dinheiro. null = só tokens (sem chute).
  costPerMillionTokens Float?
  updatedAt            DateTime @updatedAt
}
